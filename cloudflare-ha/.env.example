# Fill once. Values are literal; no shell execution or variable substitution.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
ORIGIN_ACCESS_CLIENT_ID=
ORIGIN_ACCESS_CLIENT_SECRET=

# SSH into the LXC containers. Use PASSWORD or KEY_PATH.
SSH_PRIMARY_HOST=192.0.2.10
SSH_PRIMARY_PORT=22
SSH_PRIMARY_USER=root
SSH_PRIMARY_PASSWORD=""
SSH_PRIMARY_KEY_PATH=""
SSH_PRIMARY_KEY_PASSPHRASE=""
SSH_BACKUP_HOST=192.0.2.20
SSH_BACKUP_PORT=22
SSH_BACKUP_USER=root
SSH_BACKUP_PASSWORD=""
SSH_BACKUP_KEY_PATH=""
SSH_BACKUP_KEY_PASSPHRASE=""

# Optional fallback SSH jump host; leave blank when the PC reaches both LXCs.
# Verify/pin host keys for the jump host AND both LXC destinations first.
SSH_JUMP_HOST=
SSH_JUMP_PORT=22
SSH_JUMP_USER=root
SSH_JUMP_PASSWORD=""
SSH_JUMP_KEY_PATH=""
SSH_JUMP_KEY_PASSPHRASE=""

# Witness on a third physical host: quorum, gateway and common Funnel control.
SSH_COORDINATOR_HOST=
SSH_COORDINATOR_PORT=22
SSH_COORDINATOR_USER=root
SSH_COORDINATOR_PASSWORD=""
SSH_COORDINATOR_KEY_PATH=""
SSH_COORDINATOR_KEY_PASSPHRASE=""
# Explicit shared private key fallback for quorum/witness SSH tools.
SSH_KEY_PATH=""
SSH_KEY_PASSPHRASE=""
